{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Transmission request",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "\\S"
    },
    "service": {
      "enum": [
        "police",
        "fire",
        null
      ]
    },
    "defaultCity": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100,
      "pattern": "^[^,\u0000-\u001f\u007f-\u009f]*$"
    },
    "defaultState": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 100,
      "pattern": "^[^,\u0000-\u001f\u007f-\u009f]*$"
    }
  },
  "required": [
    "text"
  ]
}
